# Copy to `.env.local` for local development or to `.env` on the VPS.
# Placeholder-only file. Do not commit real secrets.

# Public app URL used in auth callbacks, sitemap generation, and checkout redirects.
# Local: http://localhost:3000  Production: https://hireon.agency
NEXT_PUBLIC_APP_URL=<public-app-url>

# Better Auth base URL. Usually the same as NEXT_PUBLIC_APP_URL.
BETTER_AUTH_URL=<better-auth-base-url>

# PostgreSQL connection string for the Next.js app and Drizzle.
DATABASE_URL=<postgres-connection-string>

# Password for the postgres container from docker-compose.
POSTGRES_PASSWORD=<strong-postgres-password>

# Better Auth signing secret. Generate a random secret with 32+ bytes.
BETTER_AUTH_SECRET=<generated-32-plus-byte-secret>

# AES-256-GCM key for user config encryption. Must be exactly 64 hex chars.
ENCRYPTION_KEY=<64-hex-encryption-key>

# Shared secret for cron endpoints on the VPS. Generate a long random secret.
CRON_SECRET=<generated-cron-secret>

# OpenRouter API key for AI calls from Hireon-managed agents.
# Host var name is OPENROUTER_API_KEY; src/lib/docker.ts:buildEnv maps it into
# the agent container as OPENAI_API_KEY + OPENAI_BASE_URL=https://openrouter.ai/api/v1
# so agents-src/ai_provider.py can use the openai client unchanged.
OPENROUTER_API_KEY=<from-openrouter-settings-keys>

# Google OAuth credentials from Google Cloud Console.
GOOGLE_CLIENT_ID=<from-google-cloud-console>
GOOGLE_CLIENT_SECRET=<from-google-cloud-console>

# GitHub OAuth credentials from GitHub Developer Settings.
GITHUB_CLIENT_ID=<from-github-developer-settings>
GITHUB_CLIENT_SECRET=<from-github-developer-settings>

# Telegram Login / bot credentials from @BotFather.
TELEGRAM_BOT_TOKEN=<from-botfather>
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=<telegram-bot-username>

# Optional: chat id where admin notifications go (seller applications etc.).
# Get yours from @userinfobot. Leave empty to skip Telegram notifications.
TELEGRAM_ADMIN_CHAT_ID=<your-tg-chat-id>

# Optional: email notifications via Resend (https://resend.com).
# When set, every new seller application is also delivered to ADMIN_NOTIFICATION_EMAIL.
RESEND_API_KEY=<resend-api-key-or-empty>
RESEND_FROM_EMAIL=hireon <onboarding@resend.dev>
ADMIN_NOTIFICATION_EMAIL=rodimovartem999@yandex.ru

# Docker daemon connection for app-managed agent containers.
# Use ssh://... for a remote daemon; leave DOCKER_PORT at 2375 only for TCP Docker hosts.
DOCKER_HOST=<ssh://user@vps-ip-or-local-docker-host>
DOCKER_PORT=<2375-if-using-tcp-docker-host>

# YooKassa merchant credentials from the YooKassa dashboard.
YOOKASSA_SHOP_ID=<from-yookassa-dashboard>
YOOKASSA_SECRET_KEY=<from-yookassa-dashboard>
YOOKASSA_WEBHOOK_SECRET=<from-yookassa-webhook-settings>

# Set to `off` only if you intentionally disable YooKassa IP verification.
YOOKASSA_IP_CHECK=<on-or-off>

# NowPayments credentials from https://account.nowpayments.io/store/api-keys
# IPN secret: https://account.nowpayments.io/store/ipn (HMAC-SHA512 signs IPN body).
NOWPAYMENTS_API_KEY=<from-nowpayments-dashboard>
NOWPAYMENTS_IPN_SECRET=<from-nowpayments-ipn-settings>
