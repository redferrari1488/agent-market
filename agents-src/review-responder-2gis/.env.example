# Numeric branch id из URL 2GIS
TWOGIS_BRANCH_ID=70000001012345678

# Токен Telegram-бота
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token

# Numeric chat id владельца
OWNER_CHAT_ID=123456789

# Тон ответов бренда
BRAND_TONE=вежливо, профессионально, не оправдываемся за мелочи

# Интервал проверки в минутах, минимум 30
CHECK_INTERVAL_MINUTES=120

# Можно оставить пустым: агент попытается извлечь ключ с 2GIS сам
TWOGIS_PUBLIC_KEY=

# claude или openai
AI_PROVIDER=claude

# BYOK-ключи. Заполняйте только тот, который нужен для выбранного провайдера.
ANTHROPIC_API_KEY=sk-ant-your-key
OPENAI_API_KEY=

# Модель Claude по умолчанию для этого агента
CLAUDE_MODEL=claude-sonnet-4-6
