# Токен Telegram-бота из @BotFather
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token

# Канал для публикации: @channel_name или numeric -100...
CHANNEL_ID=@my_channel

# Твой личный chat_id — сюда бот шлёт черновики на одобрение (узнать: @userinfobot)
OWNER_CHAT_ID=123456789

# Ниша канала (общая тема)
TOPIC=Практические советы для малого бизнеса

# Тон голоса
TONE=дружелюбно, уверенно, с лёгким юмором

# Рубрики — по одной на строку (или через запятую). Бот ротирует их по кругу.
# Если пусто — пишет только по TOPIC.
CONTENT_PILLARS="кейсы клиентов
разбор частых ошибок
полезные инструменты
личный опыт"

# ГЛАВНОЕ для качества: 2-4 реальных поста канала. Бот копирует манеру (не темы).
# Без примеров выходит усреднённый AI-текст. Многострочное значение — в кавычках.
EXAMPLES="<вставь сюда 2-4 реальных поста, разделяя пустой строкой>"

# Кто читает канал (опц.)
AUDIENCE=владельцы малого бизнеса и самозанятые, без технического жаргона

# Правила формата (опц.): длина, эмодзи, хэштеги, призыв
FORMAT_RULES=короткие абзацы, без хэштегов, максимум 1 эмодзи, без воды

# Чего избегать (опц.)
AVOID=политика, обещания дохода, кликбейт

# Как часто готовить черновик на одобрение: 6, 12, 24 или 48
POST_INTERVAL_HOURS=24

# claude или openai — выбирает дефолтную модель (оба ходят через OpenRouter)
AI_PROVIDER=claude

# Локальный тест: твой OpenRouter-ключ. В проде ставится автоматически.
OPENAI_API_KEY=

# Опц. переопределить модель (формат OpenRouter). Дефолт — anthropic/claude-sonnet-4-6
AI_MODEL=
