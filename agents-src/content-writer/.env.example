# Токен Telegram-бота из @BotFather
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token

# Канал для публикации: @channel_name или numeric -100...
CHANNEL_ID=@my_channel

# Тема канала
TOPIC=Новости и практические советы для малого бизнеса

# Тон публикаций
TONE=дружелюбно, уверенно, с лёгким юмором

# Допустимо только 6, 12, 24 или 48
POST_INTERVAL_HOURS=24

# claude или openai — выбирает дефолтную модель. Оба провайдера ходят
# через OpenRouter; в проде платформа сама прокидывает OPENAI_API_KEY.
AI_PROVIDER=claude

# Только для локального теста: твой OpenRouter-ключ (или любой OpenAI-compatible).
# В проде ставится автоматически из платформенного OPENROUTER_API_KEY.
OPENAI_API_KEY=

# Опц. переопределить модель (формат OpenRouter). Дефолт — anthropic/claude-sonnet-4-6
AI_MODEL=
