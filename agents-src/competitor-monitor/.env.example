# JSON-массив URL-ов конкурентов, максимум 10
COMPETITOR_URLS=["https://example.com","https://example.org"]

# Токен Telegram-бота
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token

# Numeric chat id владельца
CHAT_ID=123456789

# Короткое описание бизнеса клиента для AI-контекста
BUSINESS_DESC=Мы продаём CRM для малого бизнеса и хотим отслеживать изменения на сайтах конкурентов.

# Допустимо только 12, 24 или 48
CHECK_INTERVAL_HOURS=24

# claude или openai
AI_PROVIDER=claude

# BYOK-ключи. Заполняйте только тот, который нужен для выбранного провайдера.
ANTHROPIC_API_KEY=sk-ant-your-key
OPENAI_API_KEY=

# Модель Claude по умолчанию для этого агента
CLAUDE_MODEL=claude-sonnet-4-6
