# JSON-массив URL-ов, максимум 20
WATCH_URLS=["https://example.com","https://example.org"]

# Токен Telegram-бота для уведомлений
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token

# Numeric chat id получателя
CHAT_ID=123456789

# Интервал проверки в минутах, минимум 30
CHECK_INTERVAL_MINUTES=360

# Можно оставить пустым: агент сгенерирует ключ и сохранит его в /data/api_key
API_KEY=
