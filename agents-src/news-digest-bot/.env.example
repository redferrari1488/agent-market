# Токен Telegram-бота
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token

# Канал для публикации
CHANNEL_ID=@my_channel

# JSON-массив RSS-лент, максимум 10
RSS_FEEDS=["https://example.com/rss.xml","https://example.org/feed"]

# Тон публикаций
TONE=кратко, понятно, дружелюбно

# Интервал опроса в минутах: от 15 до 1440
FETCH_INTERVAL_MINUTES=60

# Максимум постов за один цикл
MAX_POSTS_PER_CYCLE=5

# claude или openai
AI_PROVIDER=claude

# BYOK-ключи. Заполняйте только тот, который нужен для выбранного провайдера.
ANTHROPIC_API_KEY=sk-ant-your-key
OPENAI_API_KEY=

# Модель Claude по умолчанию для этого агента
CLAUDE_MODEL=claude-haiku-4-5
