# Public mirror requested for deployment workflow review.
# Copy this file to `.env.local` for local dev or to `.env` on the VPS.
# Keep this file placeholder-only. Do not commit real secrets.

# Public site URL, used in auth callbacks, sitemaps, and checkout redirects.
# Local: http://localhost:3000  Production: https://hireon.agency
NEXT_PUBLIC_APP_URL=

# Better Auth app URL. Usually same as NEXT_PUBLIC_APP_URL.
BETTER_AUTH_URL=

# PostgreSQL connection string for the Next.js app and Drizzle.
DATABASE_URL=

# Password for the local/VPS postgres container in docker-compose.
POSTGRES_PASSWORD=

# Better Auth signing secret. Generate a long random secret (32+ bytes).
BETTER_AUTH_SECRET=

# AES-256-GCM key for user config encryption. Must be 64 hex chars.
ENCRYPTION_KEY=

# Shared secret for cron endpoints on the VPS. Generate a long random secret.
CRON_SECRET=

# Google OAuth credentials from Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth credentials from GitHub Developer Settings.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Telegram Login / bot credentials from @BotFather.
TELEGRAM_BOT_TOKEN=
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=

# Docker daemon connection for app-managed agent containers.
# Example remote daemon: ssh://root@100.79.2.56
DOCKER_HOST=
DOCKER_PORT=

# YooKassa merchant credentials from the YooKassa dashboard.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_WEBHOOK_SECRET=

# Set to `off` only if you intentionally disable YooKassa IP verification.
YOOKASSA_IP_CHECK=

# Cryptomus merchant credentials from the Cryptomus dashboard.
CRYPTOMUS_MERCHANT_ID=
CRYPTOMUS_API_KEY=
CRYPTOMUS_PAYOUT_API_KEY=
CRYPTOMUS_WEBHOOK_SECRET=
